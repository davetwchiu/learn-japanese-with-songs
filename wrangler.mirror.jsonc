{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uta-nihongo-mirror-retry",
  "account_id": "32b5e6213614abf2b305d2a3fce8db09",
  "main": "worker/mirror-retry.ts",
  "compatibility_date": "2026-08-04",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "uta-nihongo-davetchiu-db",
      "database_id": "133398ee-df1d-4a55-a7ea-1f88e418f83e"
    }
  ],
  "vars": {
    "MIRROR_TARGET_URL": "https://uta-nihongo-davetchiu.davechiu.chatgpt.site/api/internal/mirror"
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
